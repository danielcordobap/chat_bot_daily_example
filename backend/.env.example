# Clave de OpenRouter. Obtenla en https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ID del modelo. Debe ser un slug presente en el catálogo de OpenRouter con precio 0.
# Si no está disponible, el arranque lo registra como error y lista los fallbacks válidos.
MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b:free

# Orígenes CORS permitidos, separados por comas. NO usar formato JSON.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Servidor
HOST=0.0.0.0
PORT=8000
